# npm supply-chain controls. Shared rationale:
# https://opentelemetry.io/site/design/supply-chain-security/

min-release-age=7
strict-allow-scripts=true
engine-strict=true
# No ignore-scripts here, unlike docsy: CI's install must run scripts for the
# allowScripts gate to fire; docsy re-enables them with a rebuild step this
# repo does not carry.

# Windows npm defaults to cmd.exe, whose quoting silently diverges from sh.
script-shell=bash
